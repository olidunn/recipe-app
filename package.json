{
  "name": "@recipe-app/root",
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bun": "^1.3.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "typescript": "^5.9.2"
  },
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules & bun --filter '*' clean",
    "dev": "bun --filter '*' dev",
    "dev:e2e": "bun --filter '@recipe-app/client' dev & bun --filter '@recipe-app/server' dev --env=test",
    "e2e": "bun --filter '@recipe-app/e2e' e2e",
    "unit-tests": "bun --filter '*' test",
    "typegen": "bun --filter '*' typegen",
    "typecheck": "bun --filter '*' typecheck",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*",
    "e2e"
  ]
}
