{
  "folders": [
    {
      "path": "apps/client"
    },
    {
      "path": "apps/server"
    },
    {
      "path": "libs/common"
    },
    {
      "path": "e2e"
    },
    {
      "name": "root",
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "biomejs.biome",
      "streetsidesoftware.code-spell-checker",
      "ms-playwright.playwright"
    ]
  },
  "settings": {
    "cSpell.words": ["Elysia", "elysiajs", "Registrator", "typebox", "wouter"],
    "editor.codeActionsOnSave": {
      "source.organizeImports.biome": "explicit",
      "source.fixAll.biome": "explicit"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[css]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "js/ts.tsdk.path": "root/node_modules/typescript/lib",
    "bun.test.filePattern": "**/*.test.{ts,tsx}"
  }
}
