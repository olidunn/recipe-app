{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recipe-app-client",
  "main": "./src/index.ts",
  "compatibility_date": "2025-10-06",
  "observability": {
    "enabled": true
  },
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./dist/client/",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "recipes.oliver-dunn.com",
      "custom_domain": true
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "VITE_SERVER_URL": "https://recipes-api.oliver-dunn.com"
      }
    }
  }
}
